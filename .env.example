STRANDS_DECIDER_URL=http://127.0.0.1:1209
DATABASE_URL="file:./dev.db"
LLAMAINDEX_API_KEY=
LLAMAINDEX_API_URL=https://api.cloud.llamaindex.ai
# Optional routing; not required for a default LlamaCloud project.
LLAMAINDEX_PROJECT_ID=
LLAMAINDEX_ORGANIZATION_ID=
PORT=3000
# IANA timezone used to resolve CURRENT_DATE
APP_TIMEZONE=America/New_York
DECIDER_TIMEOUT_MS=120000
LLAMAINDEX_TIMEOUT_MS=180000

# Unlock model connection management in Settings. Generate using:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
ADMIN_API_TOKEN=
# Optional server-side key fallbacks. Keys may also be saved through admin settings.
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
